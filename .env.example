# Kavach-VoIP environment variables
# Copy this file to .env and fill in your values.

# ── Server ────────────────────────────────────────────────────────────────
KAVACH_HOST=0.0.0.0
KAVACH_PORT=8000
KAVACH_DEBUG=false
KAVACH_TELEMETRY_INTERVAL_SEC=0.5

# ── Supabase (leave blank to use in-memory fallback) ──────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ── Future: ML model paths ────────────────────────────────────────────────
KAVACH_MODEL_DIR=./models
